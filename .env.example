TIBERO_DOC_DATA_DIR=./.data
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_INGEST_QUEUE=tibero-doc.ingest
RABBITMQ_EMBEDDING_QUEUE=tibero-doc.embedding
RABBITMQ_SYNC_QUEUE=tibero-doc.sync
WORKER_PREFETCH=1
EMBEDDING_API_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
# Host port 16432 maps to container OpenProxy 6432; `opensql` is the configured pool name.
OPENPROXY_TEST_DSN=postgresql://postgres:pg_password@127.0.0.1:16432/opensql
