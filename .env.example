TIBERO_DOC_DATA_DIR=./.data
# OpenProxy host port. URL-encode special characters in the password.
TIBERO_DOC_DSN=postgresql://postgres:change-me@127.0.0.1:16432/opensql
# inline: API processes immediately. queue: RabbitMQ + three workers.
PIPELINE_MODE=queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_INGEST_QUEUE=tibero-doc.ingest
RABBITMQ_EMBEDDING_QUEUE=tibero-doc.embedding
RABBITMQ_SYNC_QUEUE=tibero-doc.sync
WORKER_PREFETCH=1
WORKER_HEARTBEAT_SECONDS=10
WORKER_HEARTBEAT_TTL=30
WORKER_METRICS_PORT=9100
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100
# Comma-separated Patroni REST endpoints, for example http://db1:8008,http://db2:8008,http://db3:8008
PATRONI_API_URLS=
# local requires no API key. Use openai/ollama/http for an external endpoint.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL=local-hash-384
EMBEDDING_API_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
AUTH_MODE=required
PUBLIC_API_URL=https://localhost
RATE_LIMIT_PER_MINUTE=120
REDIS_URL=redis://127.0.0.1:6379/0
OBJECT_STORAGE=minio
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=tibero-documents
S3_REGION=us-east-1
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_TLS=true
# Host port 16432 maps to container OpenProxy 6432; `opensql` is the configured pool name.
OPENPROXY_TEST_DSN=postgresql://postgres:pg_password@127.0.0.1:16432/opensql
